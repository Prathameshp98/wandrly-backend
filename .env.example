# Copy to .env and fill in. Never put a real value in this file.

NODE_ENV=development
PORT=8000
LOG_LEVEL=info
TRUST_PROXY=0

# ── Database ──
DATABASE_URL=postgres://wandrly:wandrly@localhost:5432/wandrly_dev
DATABASE_POOL_MAX=5

# Supabase session pooler. For Koyeb, and for migrating production.
# PROD_DATABASE_URL=

# ── Auth ──
# Set one, never both.
SUPABASE_JWKS_URL=
# SUPABASE_JWT_SECRET=

# ── Crypto ──
ENCRYPTION_KEY=
CRON_SECRET=

# ── HTTP ──
CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8000

# ── Storage: Cloudflare R2 (S3 protocol) ──
# Endpoint: R2 → Overview → Account ID
# Keys:     R2 → Manage R2 API Tokens (Object Read & Write)
# Verify:   npm run storage:check
STORAGE_BUCKET=wandrly-media
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

# ── Optional ──
PEXELS_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=Wandrly <no-reply@wandrly.app>
SENTRY_DSN=
GOOGLE_MAPS_API_KEY=
