# ══════════════════════════════════════════════════════════════════════
# Wandrly backend — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so
# it must never contain a real value. Generate secrets: DEPLOYMENT.md step 1.
# Blank values are treated as unset, so an empty line is safe.
# ══════════════════════════════════════════════════════════════════════

# ── Runtime ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
LOG_LEVEL=info
# 0 locally; 1 on Koyeb, which sits behind a proxy.
TRUST_PROXY=0

# ── Database ──────────────────────────────────────────────────────────
# Local Postgres. Day-to-day work and the test suite both use this, so a
# mistake here cannot reach production data.
DATABASE_URL=postgres://wandrly:wandrly@localhost:5432/wandrly_dev
DATABASE_POOL_MAX=5

# Production: Supabase session pooler (IPv4, port 5432 — NOT the direct
# host, which is IPv6-only, and NOT 6543, which breaks prepared
# statements). Paste this into Koyeb at step 4.
# To migrate production, run:  DATABASE_URL="<the value below>" npm run db:migrate
# PROD_DATABASE_URL=

# ── Auth (Supabase) ───────────────────────────────────────────────────
# This project signs tokens with asymmetric ES256 keys, so there is no
# shared JWT secret to copy — verification uses the public JWKS endpoint.
# Set exactly one of these two. SUPABASE_JWT_SECRET wins if both are set,
# which would silently send every token down the wrong path.
SUPABASE_JWKS_URL=
# Legacy HS256 projects only:
# SUPABASE_JWT_SECRET=

# Only needed for Supabase Storage, which we no longer use — media lives
# on Cloudflare R2 below. Left here so the choice is visible, not lost.
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# ── Crypto ────────────────────────────────────────────────────────────
# 32 bytes hex. Encrypts booking details and payout identifiers.
# Changing this makes existing encrypted rows unreadable.
ENCRYPTION_KEY=
# Shared with the GitHub Actions cron workflow (step 5).
CRON_SECRET=

# ── HTTP ──────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8000

# ── Object storage — Cloudflare R2 ────────────────────────────────────
# R2 speaks the S3 protocol, so these are named for the protocol, not the
# vendor. Every value below comes from the CLOUDFLARE dashboard; nothing
# here involves AWS.
#
#   S3_ENDPOINT          R2 → Overview → Account ID, as
#                        https://<account-id>.r2.cloudflarestorage.com
#   S3_ACCESS_KEY_ID     R2 → Manage R2 API Tokens → Create API Token
#   S3_SECRET_ACCESS_KEY same token — shown ONCE, save it
#
# Token permission: Object Read & Write, scoped to the bucket below.
# All three must be filled in together, or the app refuses to start.
# Verify with:  npm run storage:check
STORAGE_BUCKET=wandrly-media
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2 has no regions; leave as "auto". Backblaze B2 needs its real region.
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
# Only for a public bucket or custom domain. Empty ⇒ private, signed URLs.
S3_PUBLIC_BASE_URL=

# ── Optional integrations — absent means the feature degrades ─────────
# Image search for block photos. Free, no approval: pexels.com/api
# Absent ⇒ search returns empty; uploads still work.
PEXELS_API_KEY=
# Absent ⇒ emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM=Wandrly <no-reply@wandrly.app>
# Absent ⇒ errors go to logs.
SENTRY_DSN=
# Absent ⇒ OpenStreetMap/Nominatim, which needs no key and no billing.
GOOGLE_MAPS_API_KEY=
